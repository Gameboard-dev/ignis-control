+// local patch 0007: Node's readline, enough of it to read a stream line by line. The Claude Agent SDK reads the
+// CLI's output this way (one JSON message per line), both with the "line" event and by iterating the interface.
+
+import { EventEmitter } from "./events.js";
+
+class Interface extends EventEmitter {
+  constructor(options) {
+    super();
+    const input = options?.input ?? options;
+    this.input = input;
+    this.output = options?.output ?? null;
+    this.closed = false;
+    this.rest = "";
+    this.lines = [];
+    this.wake = null;
+
+    if (input && typeof input.on === "function") {
+      input.on("data", (chunk) => this.take(chunk));
+      input.on("end", () => this.close());
+      input.on("close", () => this.close());
+      input.on("error", (error) => this.emit("error", error));
+    }
+  }
+
+  take(chunk) {
+    const text =
+      typeof chunk === "string"
+        ? chunk
+        : new TextDecoder().decode(chunk instanceof Uint8Array ? chunk : new Uint8Array(chunk));
+    this.rest += text;
+    const parts = this.rest.split("\n");
+    this.rest = parts.pop();
+
+    for (const part of parts) {
+      const line = part.endsWith("\r") ? part.slice(0, -1) : part;
+      this.lines.push(line);
+      this.emit("line", line);
+    }
+
+    this.wake?.();
+  }
+
+  close() {
+    if (this.closed) {
+      return;
+    }
+
+    this.closed = true;
+
+    if (this.rest.length) {
+      const line = this.rest;
+      this.rest = "";
+      this.lines.push(line);
+      this.emit("line", line);
+    }
+
+    this.emit("close");
+    this.wake?.();
+  }
+
+  pause() {
+    this.input?.pause?.();
+    return this;
+  }
+
+  resume() {
+    this.input?.resume?.();
+    return this;
+  }
+
+  write() {}
+
+  question(query, callback) {
+    // Nothing can be typed into a stream the browser does not own; a plugin that asks gets an empty answer rather
+    // than a wait that never ends.
+    void query;
+    callback?.("");
+  }
+
+  async *[Symbol.asyncIterator]() {
+    for (;;) {
+      if (this.lines.length) {
+        yield this.lines.shift();
+        continue;
+      }
+
+      if (this.closed) {
+        return;
+      }
+
+      await new Promise((resolve) => {
+        this.wake = () => {
+          this.wake = null;
+          resolve();
+        };
+      });
+    }
+  }
+}
+
