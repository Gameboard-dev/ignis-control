+  write(chunk) {
+    if (chunk === undefined || chunk === null) {
+      return "";
+    }
+
+    if (typeof chunk === "string") {
+      return chunk;
+    }
+
+    return this.decoder.decode(chunk, { stream: true });
+  }
+
+  end(chunk) {
+    const last = chunk ? this.write(chunk) : "";
+    return last + this.decoder.decode();
+  }
+}
+
