@@ -0,0 +1,180 @@
+// local patch 0007: the spawn that runs Claude Code through the launcher's relay.
+import { describe, expect, it, vi, beforeEach, afterEach } from "vitest";
+
+import { spawn, CLAUDE_CLI_PATH } from "./child_process.js";
+import { createFsSync } from "../fs/sync.js";
+import { createInterface } from "./readline.js";
+import { StringDecoder } from "./string_decoder.js";
+import { AsyncLocalStorage } from "./async_hooks.js";
+
+function stream(frames) {
+  return new ReadableStream({
+    start(controller) {
+      frames.forEach((frame) => controller.enqueue(new TextEncoder().encode(frame)));
+      controller.close();
+    },
+  });
+}
+
+function frame(text) {
+  return `data: ${btoa(text)}\n\n`;
+}
+
+const asked = [];
+
+function serve({ start = { id: "abc", pid: 42 }, output = [], status = 200 } = {}) {
+  return vi.fn(async (url, options) => {
+    asked.push({
+      url: String(url),
+      method: options?.method || "GET",
+      body: options?.body,
+    });
+
+    if (String(url).endsWith("/start")) {
+      return {
+        ok: status === 200,
+        status,
+        json: async () => start,
+      };
+    }
+
+    if (String(url).includes("/output/")) {
+      return { ok: true, status: 200, body: stream(output) };
+    }
+
+    return { ok: true, status: 200, json: async () => ({ written: 1 }) };
+  });
+}
+
+async function settle(times = 12) {
+  for (let i = 0; i < times; i += 1) {
+    await Promise.resolve();
+    await new Promise((resolve) => setTimeout(resolve, 0));
+  }
+}
+
+describe("spawn through the launcher's relay", () => {
+  beforeEach(() => {
+    asked.length = 0;
+    vi.stubGlobal("location", { origin: "https://vault.example" });
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it("refuses any program but the Claude Code CLI, as a missing one does", async () => {
+    vi.stubGlobal("fetch", serve());
+    const child = spawn("/usr/bin/git", ["status"]);
+    const error = await new Promise((resolve) => child.on("error", resolve));
+
+    expect(error.code).toBe("ENOENT");
+    expect(error.message).toContain("git");
+    expect(asked).toEqual([]); // nothing was asked of the launcher
+  });
+
+  it("starts the CLI, and never passes the command on", async () => {
+    vi.stubGlobal("fetch", serve({ output: [frame("hello\n"), "event: exit\ndata: 0\n\n"] }));
+    const child = spawn(CLAUDE_CLI_PATH, ["--version"], { cwd: "/anywhere" });
+    await settle();
+
+    const start = asked.find((a) => a.url.endsWith("/start"));
+    expect(start.url).toBe("https://vault.example/relay/claude/start");
+    expect(JSON.parse(start.body)).toEqual({ args: ["--version"] });
+    expect(child.pid).toBe(42);
+  });
+
+  it("gives the CLI's output as a stream and its exit code as a close event", async () => {
+    vi.stubGlobal("fetch", serve({ output: [frame('{"a":1}\n'), ": waiting\n\n", frame("more\n"), "event: exit\ndata: 0\n\n"] }));
+    const child = spawn(CLAUDE_CLI_PATH, []);
+    const read = [];
+    child.stdout.on("data", (chunk) => read.push(chunk.toString()));
+    const code = await new Promise((resolve) => child.on("close", resolve));
+
+    expect(read.join("")).toBe('{"a":1}\nmore\n');
+    expect(code).toBe(0);
+  });
+
+  it("holds what is written before the CLI has started, then sends it in order", async () => {
+    vi.stubGlobal("fetch", serve({ output: ["event: exit\ndata: 0\n\n"] }));
+    const child = spawn(CLAUDE_CLI_PATH, []);
+    child.stdin.write('{"one":1}\n');
+    child.stdin.write('{"two":2}\n');
+    await settle();
+
+    const writes = asked.filter((a) => a.url.includes("/input/"));
+    expect(writes.map((w) => new TextDecoder().decode(w.body))).toEqual([
+      '{"one":1}\n',
+      '{"two":2}\n',
+    ]);
+    expect(writes[0].url).toBe("https://vault.example/relay/claude/input/abc");
+  });
+
+  it("reports a refusal by the launcher as an error, not a silent hang", async () => {
+    vi.stubGlobal("fetch", serve({ status: 503, start: { error: "no sign-in yet" } }));
+    const child = spawn(CLAUDE_CLI_PATH, []);
+    const error = await new Promise((resolve) => child.on("error", resolve));
+
+    expect(error.message).toContain("no sign-in yet");
+  });
+
+  it("asks the launcher to stop the session when it is killed", async () => {
+    vi.stubGlobal("fetch", serve({ output: [": waiting\n\n"] }));
+    const child = spawn(CLAUDE_CLI_PATH, []);
+    await settle();
+    child.kill("SIGTERM");
+    await settle(4);
+
+    expect(asked.some((a) => a.url === "https://vault.example/relay/claude/stop/abc")).toBe(true);
+  });
+
+  it("ends with a close event when the stream drops without an exit", async () => {
+    vi.stubGlobal("fetch", serve({ output: [frame("partial")] }));
+    const child = spawn(CLAUDE_CLI_PATH, []);
+    const signal = await new Promise((resolve) => child.on("close", (code, s) => resolve(s)));
+
+    expect(signal).toBe("SIGHUP");
+  });
+
+  it("iterates the CLI's output line by line, as the agent SDK reads it", async () => {
+    vi.stubGlobal("fetch", serve({ output: [frame('{"a":1}\n{"b":'), frame('2}\n'), "event: exit\ndata: 0\n\n"] }));
+    const child = spawn(CLAUDE_CLI_PATH, []);
+    const lines = [];
+
+    for await (const line of createInterface({ input: child.stdout })) {
+      lines.push(line);
+    }
+
+    expect(lines).toEqual(['{"a":1}', '{"b":2}']);
+  });
+});
+
+describe("the modules a plugin running Claude Code also needs", () => {
+  it("decodes a character split across two chunks", () => {
+    const decoder = new StringDecoder("utf8");
+    const bytes = new TextEncoder().encode("é");
+
+    expect(decoder.write(bytes.slice(0, 1))).toBe("");
+    expect(decoder.write(bytes.slice(1))).toBe("é");
+  });
+
+  it("keeps a store for the length of a call", () => {
+    const storage = new AsyncLocalStorage();
+
+    expect(storage.getStore()).toBeUndefined();
+    expect(storage.run({ id: 1 }, () => storage.getStore().id)).toBe(1);
+    expect(storage.getStore()).toBeUndefined();
+  });
+});
+
+describe("the CLI's path in the browser", () => {
+  it("is there to be stat'ed, so a plugin's check for the CLI passes", () => {
+    const metadata = { has: () => false, toStat: () => null, get: () => null };
+    const fs = createFsSync(metadata, { get: () => null }, {});
+
+    expect(fs.existsSync(CLAUDE_CLI_PATH)).toBe(true);
+    expect(fs.statSync(CLAUDE_CLI_PATH).isFile()).toBe(true);
+    expect(() => fs.accessSync(CLAUDE_CLI_PATH, 1)).not.toThrow();
+    expect(fs.existsSync("/not-the-cli")).toBe(false);
+  });
+});
