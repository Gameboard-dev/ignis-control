diff --git a/packages/shim/src/node/async_hooks.js b/packages/shim/src/node/async_hooks.js
new file mode 100644
index 0000000..5caed19
--- /dev/null
+++ b/packages/shim/src/node/async_hooks.js
@@ -0,0 +1,87 @@
+// local patch 0007: Node's async_hooks, as much as a plugin that carries context alongside its work needs. A browser
+// tab runs one thing at a time, so the store is simply the current one, put back when the call that set it returns.
+// Context does not follow an `await` as it does in Node; what uses this here is error reporting, which reads the
+// store in the same turn it was set.
+
+export class AsyncLocalStorage {
+  constructor() {
+    this.store = undefined;
+  }
+
+  run(store, callback, ...args) {
+    const before = this.store;
+    this.store = store;
+
+    try {
+      return callback(...args);
+    } finally {
+      this.store = before;
+    }
+  }
+
+  enterWith(store) {
+    this.store = store;
+  }
+
+  exit(callback, ...args) {
+    return this.run(undefined, callback, ...args);
+  }
+
+  getStore() {
+    return this.store;
+  }
+
+  disable() {
+    this.store = undefined;
+  }
+}
+
+export class AsyncResource {
+  constructor(type) {
+    this.type = type;
+  }
+
+  runInAsyncScope(callback, thisArg, ...args) {
+    return callback.apply(thisArg, args);
+  }
+
+  emitDestroy() {
+    return this;
+  }
+
+  asyncId() {
+    return 0;
+  }
+
+  triggerAsyncId() {
+    return 0;
+  }
+
+  bind(fn) {
+    return fn;
+  }
+
+  static bind(fn) {
+    return fn;
+  }
+}
+
+export function executionAsyncId() {
+  return 0;
+}
+
+export function triggerAsyncId() {
+  return 0;
+}
+
+export function createHook() {
+  return { enable() {}, disable() {} };
+}
+
+export default {
+  AsyncLocalStorage,
+  AsyncResource,
+  executionAsyncId,
+  triggerAsyncId,
+  createHook,
+};
