+// local patch 0007: brotli through the server, which the Claudian plugin needs to load (its language files are
+// brotli-compressed and it decompresses them synchronously).
+import zlib from "node:zlib";
+import { describe, expect, it, vi, beforeEach, afterEach } from "vitest";
+
+import {
+  brotliCompressSync,
+  brotliDecompressSync,
+  deflateRawSync,
+  deflateSync,
+  gunzipSync,
+  gzipSync,
+  inflateRawSync,
+  inflateSync,
+  unzipSync,
+} from "./zlib.js";
+
+// Stands in for the Ignis server's /api/brotli route, with the same contract: base64 in JSON both ways.
+function serverStub({ status = 200, error = null } = {}) {
+  const sent = [];
+
+  class FakeXhr {
+    open(method, url, isAsync) {
+      sent.push({ method, url, isAsync });
+      this.status = status;
+    }
+
+    setRequestHeader() {}
+
+    send(body) {
+      if (error) {
+        this.responseText = JSON.stringify({ error });
+        return;
+      }
+
+      const { mode, data } = JSON.parse(body);
+      const input = Buffer.from(data, "base64");
+      const output =
+        mode === "compress"
+          ? zlib.brotliCompressSync(input)
+          : zlib.brotliDecompressSync(input);
+      this.responseText = JSON.stringify({ data: output.toString("base64") });
+    }
+  }
+
+  vi.stubGlobal("XMLHttpRequest", FakeXhr);
+  vi.stubGlobal("location", { origin: "https://vault.example" });
+  return sent;
+}
+
+describe("zlib.brotli* through the server", () => {
+  beforeEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it("decompresses what Node compressed, and gives back a Buffer", () => {
+    serverStub();
+    const text = JSON.stringify({ common: { ok: "yes" } });
+    const compressed = zlib.brotliCompressSync(Buffer.from(text));
+
+    const out = brotliDecompressSync(compressed);
+
+    expect(Buffer.isBuffer(out)).toBe(true); // callers do .toString("utf8") on it
+    expect(out.toString("utf8")).toBe(text);
+    expect(JSON.parse(out.toString("utf8")).common.ok).toBe("yes");
+  });
+
+  it("asks the server synchronously, on the page's own origin", () => {
+    const sent = serverStub();
+    brotliDecompressSync(zlib.brotliCompressSync(Buffer.from("x")));
+
+    expect(sent).toEqual([
+      { method: "POST", url: "https://vault.example/api/brotli", isAsync: false },
+    ]);
+  });
+
+  it("compresses, so that Node can read it back", () => {
+    serverStub();
+    const out = brotliCompressSync(Buffer.from("round trip"));
+
+    expect(zlib.brotliDecompressSync(out).toString("utf8")).toBe("round trip");
+  });
+
+  it("carries data larger than one String.fromCharCode call", () => {
+    serverStub();
+    const big = Buffer.alloc(200000, 7); // over the 0x8000 chunk the shim encodes in
+    const out = brotliDecompressSync(zlib.brotliCompressSync(big));
+
+    expect(out.length).toBe(big.length);
+    expect(out.equals(big)).toBe(true);
+  });
+
+  it("reports the server's own reason when it refuses", () => {
+    serverStub({ status: 422, error: "brotli could not decompress that: unexpected end of input" });
+
+    expect(() => brotliDecompressSync(Buffer.from("not brotli"))).toThrow(
+      /brotliDecompressSync: brotli could not decompress that/,
+    );
+  });
+
+  it("reports the status when the answer is not even JSON", () => {
+    serverStub({ status: 500 });
+    vi.stubGlobal(
+      "XMLHttpRequest",
+      class {
+        open() {
+          this.status = 500;
+        }
+        setRequestHeader() {}
+        send() {
+          this.responseText = "<html>no</html>";
+        }
+      },
+    );
+
+    expect(() => brotliDecompressSync(Buffer.from("x"))).toThrow(/answered 500/);
+  });
+
+  it("leaves gzip and deflate to pako, with no request at all", () => {
+    const sent = serverStub();
+    const out = gunzipSync(gzipSync(Buffer.from("local")));
+
+    expect(new TextDecoder().decode(out)).toBe("local");
+    expect(sent).toEqual([]);
+  });
+
+  it("gives a Buffer from the pako-backed functions too, as Node does", () => {
+    serverStub();
+
+    // pako answers with a Uint8Array, whose .toString() is "108,111,..." rather than text. Callers written for
+    // Node's zlib treat the result as a Buffer, so every one of these wraps it.
+    for (const [name, out] of [
+      ["gunzipSync", gunzipSync(gzipSync(Buffer.from("local")))],
+      ["gzipSync", gzipSync(Buffer.from("local"))],
+      ["inflateSync", inflateSync(deflateSync(Buffer.from("local")))],
+      ["deflateSync", deflateSync(Buffer.from("local"))],
+      ["inflateRawSync", inflateRawSync(deflateRawSync(Buffer.from("local")))],
+      ["unzipSync", unzipSync(gzipSync(Buffer.from("local")))],
+    ]) {
+      expect(Buffer.isBuffer(out), `${name} should give a Buffer`).toBe(true);
+    }
+
+    expect(gunzipSync(gzipSync(Buffer.from("local"))).toString("utf8")).toBe("local");
+    expect(inflateSync(deflateSync(Buffer.from("local"))).toString("utf8")).toBe("local");
+  });
+});
