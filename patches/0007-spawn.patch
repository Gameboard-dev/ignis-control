+// pako does deflate and gzip, not brotli, and a browser exposes no brotli a script may call: DecompressionStream
+// handles gzip and deflate only, and is asynchronous besides, while Node's brotli functions here are synchronous.
+// So the server does it, over the same kind of synchronous request the fs shim makes, with the bytes as base64.
+// The Claudian plugin needs this at load: its language files are brotli-compressed.
+
+function brotli(mode, buf) {
+  const bytes = toUint8Array(buf);
+  let binary = "";
+
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    binary += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+  }
+
+  const xhr = new XMLHttpRequest();
+  xhr.open("POST", new URL("/api/brotli", location.origin).toString(), false); // synchronous
+  xhr.setRequestHeader("Content-Type", "application/json");
+  xhr.send(JSON.stringify({ mode, data: btoa(binary) }));
+
+  if (xhr.status >= 400) {
+    let why = `the server answered ${xhr.status}`;
+
+    try {
+      why = JSON.parse(xhr.responseText).error || why;
+    } catch {
+      // the answer was not JSON; the status is all we can say
+    }
+
+    throw new Error(`zlib.brotli${mode === "compress" ? "Compress" : "Decompress"}Sync: ${why}`);
+  }
+
+  const answer = atob(JSON.parse(xhr.responseText).data);
+  const out = new Uint8Array(answer.length);
+
+  for (let i = 0; i < answer.length; i += 1) {
+    out[i] = answer.charCodeAt(i);
+  }
+
+  // A Buffer when Obsidian's one is about: callers expect Node's, and call .toString("utf8") on the result.
+  return typeof globalThis.Buffer?.from === "function" ? globalThis.Buffer.from(out) : out;
+}
