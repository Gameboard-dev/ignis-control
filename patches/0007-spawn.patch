+// local patch 0007: Node's string_decoder, which plugins use to turn a child process's output into text without
+// cutting a character in half across two chunks. TextDecoder does the same work when told to stream.
+
+export class StringDecoder {
+  constructor(encoding = "utf8") {
+    this.encoding = encoding === "utf8" ? "utf-8" : encoding;
+    this.decoder = new TextDecoder(this.encoding);
+  }
